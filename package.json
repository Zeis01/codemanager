{
  "name": "codemanager",
  "productName": "CodeManager",
  "version": "1.2.2",
  "description": "CodeManager – menedżer modów, serwerów i edytor dla gier",
  "main": "src/main/main.js",
  "author": "CodeManager",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js && node test/run-tests-2.js && node test/run-tests-3.js",
    "dist": "electron-builder --win nsis portable zip --publish never",
    "dist:dir": "electron-builder --win dir",
    "release": "electron-builder --win nsis portable zip --publish always"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.52.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.codemanager.app",
    "productName": "CodeManager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/linux/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "CodeManager-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CodeManager-Setup-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "portable": {
      "artifactName": "CodeManager-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Zeis01",
        "repo": "codemanager",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Nexus Mods",
        "schemes": [
          "nxm"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zeis01/codemanager.git"
  }
}
